# ============================================================
# Zoho OAuth Auto-Refresh (RECOMMENDED — set in Catalyst Console)
# ============================================================
# Set these three in Catalyst Console → App Settings → Environments
# Once set, the access_token is refreshed automatically forever.
ZOHO_CLIENT_ID=1000.OFMAEIENIMLDY5MMSR47NH3OX6UF7O
ZOHO_CLIENT_SECRET=your_client_secret_here
ZOHO_REFRESH_TOKEN=your_refresh_token_here

# Optional (used to override ORG/Project IDs)
CATALYST_ORG_ID=60073436832
CATALYST_PROJECT_ID=47024000000013051

# ============================================================
# Legacy Static Tokens (LOCAL DEV FALLBACK ONLY)
# These expire every ~1 hour and require manual regeneration.
# Only used if ZOHO_REFRESH_TOKEN is NOT set above.
# ============================================================
LLM_ACCESS_TOKEN=''
TRANSLATE_ACCESS_TOKEN=''
