# ============================================================
# KSP Lumina — Frontend Environment Variables
# ============================================================
# Copy to .env.local for development, or .env.production for builds.
#
# ONLY variables prefixed with VITE_ are exposed to the bundle,
# and they are INLINED AT BUILD TIME. Never put a secret here —
# anything in this file ships to every browser.
#
# In production these are set in:
#   Catalyst Console → Slate → <app> → Configuration → Environment Variables
# ============================================================

# ── API base URL ─────────────────────────────────────────────
# DEVELOPMENT: leave EMPTY. Requests then use relative paths and
# are handled by the Vite dev proxy in vite.config.js — same-origin,
# so CORS never enters the picture.
#
# PRODUCTION: set to the absolute API Gateway origin. Slate serves
# from a different domain than the functions, so this must be the
# full origin, with NO trailing slash.
#   e.g. https://your-project-60073436832.development.catalystserverless.in
VITE_API_URL=

# ── Request timeout (milliseconds) ───────────────────────────
# LLM round-trips on complex questions can take minutes.
# Keep this generous; 300000 = 5 minutes.
VITE_API_TIMEOUT=300000

# ── Dev proxy target ─────────────────────────────────────────
# Where `catalyst serve` is listening. Used by vite.config.js only —
# this never reaches the bundle. Ignored in production builds.
VITE_BACKEND_URL=http://localhost:3000

# ── Catalyst project identifiers ─────────────────────────────
VITE_CATALYST_APP_ID=your_app_id_here
VITE_CATALYST_DOMAIN=your-project-60073436832.development
